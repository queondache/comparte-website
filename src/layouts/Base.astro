---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PageKey } from '../i18n';
interface Props { lang: 'it' | 'es' | 'en'; pageKey: PageKey; title: string; description: string; noindex?: boolean }
const { lang, pageKey, title, description, noindex = false } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} pageKey={pageKey} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
